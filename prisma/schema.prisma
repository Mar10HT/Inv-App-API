// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  role      UserRole  @default(VIEWER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  inventoryItems   InventoryItem[]      @relation("CreatedItems")
  assignedItems    InventoryItem[]      @relation("AssignedItems")
  auditLogs        AuditLog[]
  transactions     Transaction[]
  loans            Loan[]
  receivedLoans    Loan[]               @relation("ReceivedLoans")
  returnConfirmedLoans Loan[]           @relation("ReturnConfirmedLoans")

  // Transfer Request relations
  requestedTransfers  TransferRequest[]   @relation("RequestedTransfers")
  approvedTransfers   TransferRequest[]   @relation("ApprovedTransfers")
  receivedTransfers   TransferRequest[]   @relation("ReceivedTransfers")

  // Stock Take relations
  startedStockTakes   StockTake[]         @relation("StartedStockTakes")
  completedStockTakes StockTake[]         @relation("CompletedStockTakes")

  // Discharge Request relations
  resolvedDischarges  DischargeRequest[]  @relation("ResolvedDischarges")

  // Auth tokens relations
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // Warehouse access control
  managedWarehouses   Warehouse[]     @relation("WarehouseManager")
  warehouseAccess     UserWarehouse[]

  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  SYSTEM_ADMIN      // Full access to everything
  WAREHOUSE_MANAGER // Manage inventory, warehouses, transactions
  USER              // Basic access to view and create items
  VIEWER            // Read-only access
  EXTERNAL          // Minimal access, for external users/contractors
}

// Warehouse model
model Warehouse {
  id          String   @id @default(cuid())
  name        String
  location    String
  description String?
  isActive    Boolean  @default(true)
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  manager                 User?            @relation("WarehouseManager", fields: [managerId], references: [id])
  userAccess              UserWarehouse[]
  inventoryItems          InventoryItem[]
  sourceTransactions      Transaction[]    @relation("SourceTransactions")
  destinationTransactions Transaction[]    @relation("DestinationTransactions")
  sourceLoans             Loan[]           @relation("SourceLoans")
  destinationLoans        Loan[]           @relation("DestinationLoans")

  // Transfer Request relations
  sourceTransferRequests      TransferRequest[] @relation("SourceTransferRequests")
  destinationTransferRequests TransferRequest[] @relation("DestinationTransferRequests")

  // Stock Take relation
  stockTakes              StockTake[]

  // Discharge Request relations
  dischargeRequests       DischargeRequest[]

  @@map("warehouses")
}

// Junction table for user-warehouse access control
model UserWarehouse {
  id          String   @id @default(cuid())
  userId      String
  warehouseId String
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([userId])
  @@index([warehouseId])
  @@map("user_warehouses")
}

// Inventory Item model
model InventoryItem {
  id           String            @id @default(cuid())
  name         String
  description  String?
  quantity     Int               @default(0)
  minQuantity  Int               @default(10) // For low stock alerts
  category     String            // Legacy: category name as string
  categoryRef  Category?         @relation(fields: [categoryId], references: [id])
  categoryId   String?           // New: relation to Category model
  status       InventoryStatus   @default(IN_STOCK)
  price        Float?
  currency     Currency          @default(USD) // Currency type
  sku          String?           @unique
  barcode      String?
  imageUrl     String?

  // Product model/brand
  model        String?

  // Item type fields
  itemType     ItemType          @default(BULK) // UNIQUE or BULK
  serviceTag   String?           @unique // For unique items (PCs, laptops, etc.)
  serialNumber String?           // Alternative to serviceTag

  // Warehouse relationship
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId  String

  // Supplier relationship (optional)
  supplier     Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId   String?

  // Assignment tracking for UNIQUE items
  assignedToUser   User?         @relation("AssignedItems", fields: [assignedToUserId], references: [id])
  assignedToUserId String?
  assignedAt       DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?         // Soft delete
  createdBy    User?             @relation("CreatedItems", fields: [createdById], references: [id])
  createdById  String?

  // Relations
  auditLogs         AuditLog[]
  transactionItems  TransactionItem[]
  loans             Loan[]

  // New relations for Phase 3
  stockAlerts            StockAlert[]
  transferRequestItems   TransferRequestItem[]
  stockTakeItems         StockTakeItem[]
  dischargeRequestItems  DischargeRequestItem[]

  @@index([category])
  @@index([categoryId])
  @@index([status])
  @@index([currency])
  @@index([warehouseId])
  @@index([itemType])
  @@index([supplierId])
  @@index([assignedToUserId])
  @@index([deletedAt])
  @@map("inventory_items")
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  IN_USE        // UNIQUE item assigned to a user
}

enum Currency {
  USD  // United States Dollar
  HNL  // Honduran Lempira
}

enum ItemType {
  UNIQUE  // Serialized items (PCs, laptops) - each unit is tracked individually
  BULK    // Accumulated items (screws, nails) - tracked by total quantity
}

// Audit Log for tracking changes
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // InventoryItem, User, etc.
  entityId  String
  changes   Json?    // Store old and new values
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  item      InventoryItem? @relation(fields: [itemId], references: [id])
  itemId    String?

  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Supplier model for tracking vendors
model Supplier {
  id          String   @id @default(cuid())
  name        String
  location    String
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

// Category model for organizing inventory items
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inventoryItems InventoryItem[]

  @@map("categories")
}

// Transaction model for tracking item movements between warehouses
model Transaction {
  id                     String    @id @default(cuid())
  type                   String    // TRANSFER, IN, OUT
  sourceWarehouseId      String?
  destinationWarehouseId String?
  userId                 String
  date                   DateTime
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  sourceWarehouse      Warehouse? @relation("SourceTransactions", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse? @relation("DestinationTransactions", fields: [destinationWarehouseId], references: [id])
  user                 User       @relation(fields: [userId], references: [id])
  items                TransactionItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([userId])
  @@index([date])
  @@map("transactions")
}

// TransactionItem model for tracking individual items in a transaction
model TransactionItem {
  id              String   @id @default(cuid())
  transactionId   String
  inventoryItemId String
  quantity        Int
  notes           String?

  // Relations
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([inventoryItemId])
  @@map("transaction_items")
}

// Loan model for tracking item loans between warehouses
model Loan {
  id                     String     @id @default(cuid())
  inventoryItemId        String
  quantity               Int        @default(1)
  sourceWarehouseId      String
  destinationWarehouseId String
  loanDate               DateTime   @default(now())
  dueDate                DateTime
  returnDate             DateTime?
  status                 LoanStatus @default(PENDING)
  notes                  String?
  createdById            String
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // QR Code fields for confirmation flow
  sendQrCode             String?    @unique  // QR to confirm shipment receipt
  returnQrCode           String?    @unique  // QR to confirm return receipt

  // Receipt confirmation
  receivedAt             DateTime?           // When receiver confirmed receipt
  receivedById           String?             // Who confirmed receipt

  // Return confirmation
  returnConfirmedAt      DateTime?           // When return was confirmed
  returnConfirmedById    String?             // Who confirmed return

  // Relations
  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id])
  sourceWarehouse      Warehouse     @relation("SourceLoans", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse     @relation("DestinationLoans", fields: [destinationWarehouseId], references: [id])
  createdBy            User          @relation(fields: [createdById], references: [id])
  receivedBy           User?         @relation("ReceivedLoans", fields: [receivedById], references: [id])
  returnConfirmedBy    User?         @relation("ReturnConfirmedLoans", fields: [returnConfirmedById], references: [id])

  @@index([inventoryItemId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([dueDate])
  @@index([createdById])
  @@index([sendQrCode])
  @@index([returnQrCode])
  @@map("loans")
}

enum LoanStatus {
  PENDING        // Created, waiting to be sent
  SENT           // Shipped, QR generated for receipt
  RECEIVED       // Receiver confirmed receipt
  RETURN_PENDING // Return initiated, QR generated
  RETURNED       // Return confirmed
  OVERDUE        // Past due date (can be in SENT or RECEIVED state)
  CANCELLED      // Loan cancelled
}

// Stock Alert model for low stock notifications
model StockAlert {
  id            String      @id @default(cuid())
  itemId        String
  type          AlertType
  threshold     Int         // The minQuantity threshold
  currentQty    Int         // Quantity when alert was created
  notified      Boolean     @default(false)
  notifiedAt    DateTime?
  resolvedAt    DateTime?   // When stock was replenished
  createdAt     DateTime    @default(now())

  // Relations
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([type])
  @@index([notified])
  @@index([createdAt])
  @@map("stock_alerts")
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
}

// Transfer Request model for approval workflow
model TransferRequest {
  id                     String        @id @default(cuid())
  status                 RequestStatus @default(PENDING)
  sourceWarehouseId      String
  destinationWarehouseId String
  requestedById          String
  approvedById           String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectedReason         String?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // QR Code fields for confirmation workflow
  sendQrCode             String?       @unique
  receivedAt             DateTime?
  receivedById           String?

  // Relations
  sourceWarehouse      Warehouse              @relation("SourceTransferRequests", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse              @relation("DestinationTransferRequests", fields: [destinationWarehouseId], references: [id])
  requestedBy          User                   @relation("RequestedTransfers", fields: [requestedById], references: [id])
  approvedBy           User?                  @relation("ApprovedTransfers", fields: [approvedById], references: [id])
  receivedBy           User?                  @relation("ReceivedTransfers", fields: [receivedById], references: [id])
  items                TransferRequestItem[]

  @@index([status])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([requestedById])
  @@index([createdAt])
  @@map("transfer_requests")
}

model TransferRequestItem {
  id                String          @id @default(cuid())
  transferRequestId String
  inventoryItemId   String
  quantity          Int

  // Relations
  transferRequest TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([transferRequestId])
  @@index([inventoryItemId])
  @@map("transfer_request_items")
}

enum RequestStatus {
  PENDING      // Created, awaiting approval
  APPROVED     // Approved by manager
  SENT         // Items shipped, QR generated for receipt
  RECEIVED     // Receiver confirmed via QR scan
  COMPLETED    // Transfer finalized
  REJECTED     // Rejected by approver
  CANCELLED    // Cancelled
}

// Stock Take model for inventory reconciliation
model StockTake {
  id            String          @id @default(cuid())
  warehouseId   String
  status        StockTakeStatus @default(IN_PROGRESS)
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  startedById   String
  completedById String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  startedBy     User            @relation("StartedStockTakes", fields: [startedById], references: [id])
  completedBy   User?           @relation("CompletedStockTakes", fields: [completedById], references: [id])
  items         StockTakeItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([startedAt])
  @@map("stock_takes")
}

model StockTakeItem {
  id            String     @id @default(cuid())
  stockTakeId   String
  itemId        String
  expectedQty   Int        // System quantity
  countedQty    Int?       // Physical count
  variance      Int?       // Difference (countedQty - expectedQty)
  notes         String?
  countedAt     DateTime?
  createdAt     DateTime   @default(now())

  // Relations
  stockTake     StockTake     @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([stockTakeId])
  @@index([itemId])
  @@map("stock_take_items")
}

enum StockTakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// Phase 5: Production Security Models
// ============================================

// Login attempts tracking for brute force protection
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// Refresh tokens for secure token rotation
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// Phase 6: Discharge Request Models
// ============================================

// Discharge Request - public form for requesting materials
model DischargeRequest {
  id                 String                  @id @default(cuid())
  requesterName      String
  requesterPosition  String?
  requesterPhone     String?
  neededByDate       DateTime?
  justification      String?
  warehouseId        String
  status             DischargeRequestStatus  @default(PENDING)
  resolvedById       String?
  resolvedAt         DateTime?
  rejectedReason     String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Relations
  warehouse          Warehouse               @relation(fields: [warehouseId], references: [id])
  resolvedBy         User?                   @relation("ResolvedDischarges", fields: [resolvedById], references: [id])
  items              DischargeRequestItem[]

  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("discharge_requests")
}

model DischargeRequestItem {
  id                  String            @id @default(cuid())
  dischargeRequestId  String
  inventoryItemId     String
  quantity            Int

  // Relations
  dischargeRequest    DischargeRequest  @relation(fields: [dischargeRequestId], references: [id], onDelete: Cascade)
  inventoryItem       InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([dischargeRequestId])
  @@index([inventoryItemId])
  @@map("discharge_request_items")
}

enum DischargeRequestStatus {
  PENDING    // Created, awaiting resolution
  COMPLETED  // Approved and items delivered
  REJECTED   // Rejected by manager
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
