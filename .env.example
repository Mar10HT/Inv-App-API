# Database
# For development (SQLite)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/inv_app_db?schema=public"

# JWT Secret - REQUIRED! Generate a secure random string for production
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app will NOT start without this variable set
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# App Config
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:4200"
