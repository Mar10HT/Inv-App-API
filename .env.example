# Database (PostgreSQL for dev and prod)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/obsid_dev?schema=public"

# JWT Secret - REQUIRED! Generate a secure random string for production
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app will NOT start without this variable set
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# App Config
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:4200"

# Email Configuration (Optional - emails will be logged if not configured)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM_EMAIL="noreply@invapp.com"
# SMTP_FROM_NAME="InvApp"

# Frontend URL (for password reset links)
APP_URL="http://localhost:4200"

# CSRF Secret - REQUIRED! Generate a secure random string for production
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CSRF_SECRET=""

# Sentry Error Tracking (Optional - error tracking disabled if not configured)
# Get your DSN from https://sentry.io
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ---------------------------------------------------------------------------
# Multi-tenant (Phase 0 — feature flag off by default)
# ---------------------------------------------------------------------------
# Master switch. When false, all tenant logic is a no-op and app behaves as single-tenant.
MULTI_TENANT_ENABLED=false

# LRU cache for warehouseIds lookup per (userId, orgId). TTL in ms and max entries.
TENANT_WAREHOUSE_CACHE_TTL_MS=45000
TENANT_WAREHOUSE_CACHE_MAX=5000

# SUPER_ADMIN impersonation guardrail: max duration of X-Org-Id override (minutes).
SUPER_ADMIN_IMPERSONATION_MAX_MIN=30

# Default organization created by seed when MULTI_TENANT_ENABLED=true.
DEFAULT_ORG_SLUG="ON"
DEFAULT_ORG_NAME="Olancho Net"
